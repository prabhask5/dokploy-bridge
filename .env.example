# dokploy-bridge needs ONE variable: DOKPLOY_API_KEY. Everything else is optional and
# shown with its default.

# API key of a Dokploy owner or admin (Dokploy -> Settings -> Profile -> API/CLI).
# Only owners and admins can read the GitHub App's private key, which the bridge
# uses to talk to GitHub as Dokploy's own GitHub App.
DOKPLOY_API_KEY=

# The public address of your Dokploy dashboard, e.g. https://dokploy.example.com
# Used for "Open in Dokploy" links on GitHub. Without it, checks have no link.
DOKPLOY_PUBLIC_URL=

# Where the bridge reaches Dokploy's API. The default works on dokploy-network.
DOKPLOY_URL=http://dokploy:3000

# How often to poll Dokploy, in seconds (5 or more).
POLL_SECONDS=10

# Comma-separated app names to leave alone. An app can also opt out with
# "dokploy-bridge: off" in its description in Dokploy.
IGNORE_APPS=

# Features (true/false).
PREVIEW_PORT_SYNC=true
PREVIEW_ENV_INHERIT=true
GITHUB_DEPLOYMENTS=true
GITHUB_CHECKS=true
PREVIEW_CLEANUP=true
# Deleting the empty "Preview (PR #n)" environment needs the GitHub App's
# Administration: write permission. Set false if you don't grant it.
DELETE_PREVIEW_ENVIRONMENTS=true

# Settings for apps created from now on, applied once. Leave a line empty to keep
# Dokploy's own default for it. Apps that already exist are never changed.
# Rollbacks: the registry's name (or ID) in Dokploy.
NEW_APP_ROLLBACK_REGISTRY=
# Previews (applied when the app is connected to GitHub). Certificate: none,
# letsencrypt or custom; "none" when Cloudflare's origin certificate covers the wildcard.
NEW_APP_PREVIEWS=
NEW_APP_PREVIEW_WILDCARD=
NEW_APP_PREVIEW_HTTPS=
NEW_APP_PREVIEW_CERTIFICATE=
NEW_APP_PREVIEW_LIMIT=
NEW_APP_PREVIEW_COLLABORATORS_ONLY=

# Settings for application domains added from now on, applied once. Leave a line
# empty to keep what Dokploy set. The port comes from the Dockerfile's last EXPOSE.
NEW_DOMAIN_HTTPS=
NEW_DOMAIN_CERTIFICATE=
NEW_DOMAIN_PORT_FROM_DOCKERFILE=false

# Uptime Kuma monitors for new domains (off while KUMA_URL is empty). The user
# must not have 2FA on. The status page is optional; new monitors join its group
# in alphabetical order.
KUMA_URL=
KUMA_USERNAME=
KUMA_PASSWORD=
KUMA_STATUS_PAGE=
KUMA_STATUS_GROUP=Services
KUMA_MONITOR_INTERVAL=60
KUMA_MONITOR_RETRIES=2
KUMA_MONITOR_RETRY_INTERVAL=20
KUMA_MONITOR_TIMEOUT=48
KUMA_MONITOR_RESEND=0
KUMA_MONITOR_EXPIRY_NOTIFICATION=true
KUMA_MONITOR_MAX_REDIRECTS=10
KUMA_MONITOR_ACCEPTED_STATUS=200-299
# Notification names, comma-separated. Empty: Kuma's default notifications.
KUMA_MONITOR_NOTIFICATIONS=
# Refuse to delete more monitors than this in one go.
KUMA_MAX_DELETES_PER_TICK=3

# Names shown on GitHub. Keep the quotes on ENVIRONMENT_PREVIEW: an unquoted " #"
# starts a comment. It must contain {pr}.
CHECK_NAME_PRODUCTION=Dokploy
CHECK_NAME_PREVIEW=Dokploy Preview
ENVIRONMENT_PRODUCTION=Production
ENVIRONMENT_PREVIEW="Preview (PR #{pr})"

# Lines of the build log in a check (0 for none). Check output is public on
# public repositories; values from the app's env are masked.
LOG_TAIL_LINES_SUCCESS=25
LOG_TAIL_LINES_FAILURE=80

# DRY_RUN=true logs every change it would make instead of making it.
DRY_RUN=false
# info or debug
LOG_LEVEL=info
