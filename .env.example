# ---- Required ----
# API key of a Dokploy owner or admin (Dokploy -> Settings -> Profile -> API/CLI).
# It must be able to read the GitHub provider's private key, which only owners/admins can.
DOKPLOY_API_KEY=

# ---- Recommended ----
# Public URL of your Dokploy dashboard, used for "Open in Dokploy" links on GitHub.
DOKPLOY_PUBLIC_URL=https://dokploy.example.com
# Name of an existing app whose build/rollback/preview settings become the defaults for new apps.
# Captured once into /data/defaults.json; the app can be deleted afterwards.
TEMPLATE_APP=

# ---- Optional (defaults shown) ----
# DOKPLOY_URL=http://dokploy:3000
# POLL_SECONDS=10
# IGNORE_APPS=                     # comma-separated app names to leave alone
# DEFAULTS=true
# PREVIEW_PORT_SYNC=true
# PREVIEW_ENV_INHERIT=true
# GITHUB_DEPLOYMENTS=true
# GITHUB_CHECKS=true
# PREVIEW_CLEANUP=true
# DELETE_PREVIEW_ENVIRONMENTS=true
# CHECK_NAME_PRODUCTION=Dokploy
# CHECK_NAME_PREVIEW=Dokploy Preview
# ENVIRONMENT_PRODUCTION=Production
# ENVIRONMENT_PREVIEW="Preview (PR #{pr})"   # keep the quotes: an unquoted " #" starts a comment
# LOG_TAIL_LINES_SUCCESS=25
# LOG_TAIL_LINES_FAILURE=80
# DRY_RUN=false
# LOG_LEVEL=info
