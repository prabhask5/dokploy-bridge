# Dokploy owner/admin API key (Dokploy -> Settings -> Profile -> API keys)
DOKPLOY_API_KEY=
DOKPLOY_PUBLIC_URL=https://deploy.prabhas.io
# App whose settings become the defaults for new apps (read once, frozen into data/defaults.json)
TEMPLATE_APP=
# Optional: POLL_SECONDS=10  STATE_FILE=/data/state.json  DEFAULTS_FILE=/data/defaults.json
